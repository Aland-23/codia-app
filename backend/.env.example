GEMINI_API_KEY=tu_clave_gemini_aqui
GROQ_API_KEY=tu_clave_groq_aqui

# Opcional: nombre del modelo de Gemini que genera imágenes.
# Si Google cambia el nombre del modelo, actualízalo aquí sin tocar el código.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Opcional: nombre del modelo de Whisper (transcripción de voz) que usa Groq.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Opcional: nombre del modelo de chat de Groq (el respaldo de texto).
# Groq retiró llama-3.3-70b-versatile y llama-3.1-8b-instant en junio de
# 2026; si vuelve a dar 404 "model_not_found", revisa la lista vigente en
# https://console.groq.com/docs/models
GROQ_CHAT_MODEL=openai/gpt-oss-20b
