# ---- Claves de API (puedes poner VARIAS por proveedor para evitar saturación) ----
# Cada clave gratuita tiene su propio límite de peticiones. Con varias, CodIA
# reparte la carga y, si una se agota (error 429), salta sola a la siguiente.
# Lo ideal: claves de cuentas/proyectos de Google distintos.
#
# Forma 1 (recomendada): una lista separada por comas
GEMINI_API_KEYS=tu_clave_gemini_1,tu_clave_gemini_2,tu_clave_gemini_3
GROQ_API_KEYS=tu_clave_groq_1,tu_clave_groq_2
#
# Forma 2: numeradas (hasta _20). También sirve GEMINI_API_KEY a secas.
# GEMINI_API_KEY=tu_clave_gemini_aqui
# GEMINI_API_KEY_2=tu_clave_gemini_2
# GROQ_API_KEY=tu_clave_groq_aqui
# GROQ_API_KEY_2=tu_clave_groq_2

# Opcional: nombre del modelo de Gemini que genera imágenes.
# Si Google cambia el nombre del modelo, actualízalo aquí sin tocar el código.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Opcional: nombre del modelo de Whisper (transcripción de voz) que usa Groq.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Opcional: nombre del modelo de chat de Groq (el respaldo de texto).
# Groq retiró llama-3.3-70b-versatile y llama-3.1-8b-instant en junio de
# 2026; si vuelve a dar 404 "model_not_found", revisa la lista vigente en
# https://console.groq.com/docs/models
GROQ_CHAT_MODEL=openai/gpt-oss-20b
